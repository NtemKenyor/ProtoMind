# ── Server Configuration ──────────────────────────────────────────────
PORT=3000

# ── Meta Model API (Muse) Configuration ──────────────────────────────
# Get your API key from https://dev.meta.ai/platform
MODEL_API_KEY="your-muse-api-key-here"
META_BASE_URL="https://api.meta.ai/v1"

# ── Model Selection (Muse models) ─────────────────────────────────────
# Standard mode models: muse-spark-1.3, muse-spark-1.2, muse-spark-1.1
# Contributor mode models: muse-spark-1.3-contributor, muse-spark-1.2-contributor
META_MODEL_FAST="muse-spark-1.3"
META_MODEL_SMART="muse-spark-1.3"
META_MODEL_ARCHITECT="muse-wonder-1.0"
META_MODEL_CODE="muse-spark-1.3"
META_MODEL_VISION="muse-spark-1.3"